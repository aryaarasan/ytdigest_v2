rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function unlocked(videoId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/summaryUnlocks/$(videoId));
    }

    function editableUserFields() {
      return ['channels', 'country', 'timezone', 'email',
        'notificationsEnabled', 'daysBack', 'saved', 'digestHour'];
    }

    function creatableUserFields() {
      return ['channels', 'country', 'timezone', 'email',
        'notificationsEnabled', 'daysBack', 'saved', 'digestHour', 'createdAt'];
    }

    // Billing, trial, and developer state are written only by Cloud Functions.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(creatableUserFields());
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(editableUserFields());
      allow delete: if isOwner(userId)
        && request.auth.token.firebase.sign_in_provider == 'anonymous';

      // Analytics subcollection — uid-scoped; users cannot read each other's data
      match /quota/{monthDoc} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // Activity is recorded and aggregated by authenticated Cloud Functions.
      match /summaryOpens/{openId} {
        allow read, write: if false;
      }
      match /summaryUnlocks/{videoId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    // Full cache entries are available only after an account unlock. List queries are denied.
    match /videoCache/{videoId} {
      allow get: if unlocked(videoId);
      allow list: if false;
      allow write: if false;
    }

    // Transcript cache — authenticated read, no client writes
    match /transcriptCache/{videoId} {
      allow get: if unlocked(videoId);
      allow list: if false;
      allow write: if false;
    }

    // Daily quota counters — server-side only; no client reads or writes
    // Cloud Functions use the admin SDK which bypasses these rules.
    match /quotas/{userId} {
      allow read, write: if false;
    }
  }
}
